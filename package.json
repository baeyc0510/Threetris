{
  "name": "threetris",
  "version": "1.0.0",
  "description": "3D Tetris - a Three.js synthwave 3D block puzzle",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "desktop:dev": "npm run build && electron .",
    "desktop:package": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "electron": "^37.2.6",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "com.threetris.game",
    "productName": "TETRIS 3D",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "artifactName": "TETRIS-3D-Portable-${version}.${ext}"
    }
  }
}
